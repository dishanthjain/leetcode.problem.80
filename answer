class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int k = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (k < 2 || nums[i] != nums[k - 2]) {
                nums[k] = nums[i];
                k++;
            }
        }

        return k;
    }
};


Explanation:

Use k to track the position where the next valid element should be placed. If fewer than two elements are stored or the current element differs from nums[k-2], add it to the array. Finally, return k.
